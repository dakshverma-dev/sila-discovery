{
  "name": "sila-discovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "demo": "node scripts/sila-demo.mjs",
    "demo:seed": "node scripts/sila-demo.mjs --seed-only",
    "demo:build": "node scripts/build-customer-demo.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:reset": "supabase db reset",
    "test:e2e": "playwright test",
    "perf": "vitest run --config vitest.perf.config.ts",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "test:live": "vitest run --config vitest.live.config.ts --silent=false",
    "discovery": "node scripts/discovery-local.mjs",
    "discovery:prepare": "node scripts/discovery-local.mjs --prepare",
    "discovery:start": "node scripts/discovery-local.mjs --production",
    "discovery:verify": "node scripts/verify-discovery.mjs",
    "submission:package": "python scripts/package_submission.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "lenis": "1.3.26",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.3",
    "supabase": "2.120.0",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
