{
  "name": "shared-cultural-bookings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:reference": "python -m unittest discover -s specs -p \"test_*.py\"",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:reset": "supabase db reset",
    "test:e2e": "playwright test",
    "perf": "vitest run --config vitest.perf.config.ts",
    "check:bundle": "node scripts/check-client-bundle.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "supabase": "2.120.0",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
