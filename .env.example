# Supabase Auth (email sign-in links). Local values: `npx supabase status -o env` (API_URL, ANON_KEY).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server-only project overrides for isolated preview/rehearsal stacks.
SILA_AUTH_URL=
SILA_AUTH_PUBLIC_KEY=
SUPABASE_SERVICE_ROLE_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
WORKER_TRIGGER_SECRET=
DEMO_CAPABILITY_SECRET=
# Public origin of this app; used in the emailed sign-in link (e.g. http://localhost:3000, http://localhost:3100 for e2e).
APP_BASE_URL=
DEMO_MODE=

# Signs the retained organiser-request cookie (HMAC-SHA256). At least 32 random characters, e.g. `openssl rand -hex 32`.
SILA_DRAFT_SECRET=

# Least-privilege login for the guarded scb_api functions (see supabase/seed.sql).
DATABASE_URL=

# Sandbox creations per IP per 10 minutes (default 5).
SANDBOX_RATE_LIMIT=

# Shared secret for /api/v1/internal/tick (match-run recovery). Vercel Cron may use CRON_SECRET.
